---
import Layout from "../layouts/Layout.astro";
import SidebarFilters from "../components/SidebarFilters.astro";
import SearchHeader from "../components/SearchHeader.astro";
import ProductCard from "../components/ProductCard.astro";
import {
    formatInr,
    getCategories,
    getCategoryMap,
    getProductHref,
    getProducts,
    resolveProductImage,
} from "../lib/catalog";

const [products, categories, categoryMap] = await Promise.all([
    getProducts(),
    getCategories(),
    getCategoryMap(),
]);

const categoryOptions = categories.map((category) => ({
    id: category.id,
    title: category.data.title,
}));
---

<Layout title="Collections | Kanishka Creations">
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="flex flex-col lg:flex-row gap-12">
            <SidebarFilters />

            <div class="flex-1">
                <SearchHeader
                    title="All Collections"
                    itemsCount={products.length}
                    category="All Products"
                />

                <div
                    id="product-grid"
                    class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-2 xl:grid-cols-3 gap-8"
                >
                    {
                        products.map((product) => (
                            <div
                                class="product-item"
                                data-category={product.data.category}
                                data-price={product.data.priceInr}
                                data-title={product.data.title.toLowerCase()}
                            >
                                <ProductCard
                                    href={getProductHref(product)}
                                    category={categoryMap.get(product.data.category)
                                        ?.data.title || "Collection"}
                                    title={product.data.title}
                                    price={formatInr(product.data.priceInr)}
                                    image={resolveProductImage(product.data.image)}
                                    badge={product.data.badge || null}
                                />
                            </div>
                        ))
                    }
                </div>

                <div id="no-results" class="hidden py-20 text-center">
                    <span
                        class="material-symbols-outlined text-6xl text-slate-300 mb-4 font-light"
                        >search_off</span
                    >
                    <h3 class="text-xl font-bold mb-2">No results found</h3>
                    <p class="text-slate-500">
                        Try adjusting your filters or search terms.
                    </p>
                    <button
                        id="clear-filters"
                        class="mt-6 text-primary font-bold hover:underline"
                        >Clear all filters</button
                    >
                </div>
            </div>
        </div>
    </main>
</Layout>

<script define:vars={{ categoryOptions }}>
    const productGrid = document.getElementById("product-grid");
    const noResults = document.getElementById("no-results");
    const productItems = Array.from(document.querySelectorAll(".product-item"));
    const categoryBtns = document.querySelectorAll(".category-btn");
    const priceRange = document.getElementById("price-range");
    const priceDisplay = document.getElementById("price-display");
    const sortSelect = document.getElementById("sort-select");
    const categoryDisplay = document.getElementById("category-display");
    const itemsCountDisplay = document.getElementById("items-count-display");
    const clearFiltersBtn = document.getElementById("clear-filters");
    const gridViewBtn = document.querySelector(".grid-view-btn");
    const listViewBtn = document.querySelector(".list-view-btn");

    let currentCategory = "all";
    let currentMaxPrice = 10000;
    let searchQuery = "";

    function updateFilters() {
        const urlParams = new URLSearchParams(window.location.search);
        currentCategory = urlParams.get("category") || "all";
        searchQuery = (urlParams.get("q") || "").toLowerCase();

        categoryBtns.forEach((btn) => {
            btn.classList.toggle("active", btn.dataset.category === currentCategory);
        });

        const activeCategory = categoryOptions.find(
            (category) => category.id === currentCategory,
        );
        if (categoryDisplay) {
            categoryDisplay.textContent = activeCategory
                ? activeCategory.title
                : "All Products";
        }

        let visibleCount = 0;
        productItems.forEach((item) => {
            const matchesCategory =
                currentCategory === "all" ||
                item.dataset.category === currentCategory;
            const matchesPrice =
                Number(item.dataset.price || 0) <= currentMaxPrice;
            const matchesSearch =
                !searchQuery ||
                (item.dataset.title || "").includes(searchQuery);

            const isVisible = matchesCategory && matchesPrice && matchesSearch;
            item.style.display = isVisible ? "block" : "none";
            if (isVisible) visibleCount++;
        });

        if (itemsCountDisplay) {
            itemsCountDisplay.textContent = visibleCount.toLocaleString();
        }

        productGrid?.classList.toggle("hidden", visibleCount === 0);
        noResults?.classList.toggle("hidden", visibleCount !== 0);
    }

    function setView(view) {
        if (!gridViewBtn || !listViewBtn || !productGrid) return;

        productGrid.className = view === "grid"
            ? "grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-2 xl:grid-cols-3 gap-8"
            : "flex flex-col gap-6";

        gridViewBtn.classList.toggle("bg-slate-200", view === "grid");
        gridViewBtn.classList.toggle("dark:bg-white/10", view === "grid");
        gridViewBtn.classList.toggle("text-slate-900", view === "grid");
        gridViewBtn.classList.toggle("dark:text-white", view === "grid");
        gridViewBtn.classList.toggle("text-slate-500", view !== "grid");

        listViewBtn.classList.toggle("bg-slate-200", view === "list");
        listViewBtn.classList.toggle("dark:bg-white/10", view === "list");
        listViewBtn.classList.toggle("text-slate-900", view === "list");
        listViewBtn.classList.toggle("dark:text-white", view === "list");
        listViewBtn.classList.toggle("text-slate-500", view !== "list");

        productItems.forEach((item) => {
            const card = item.querySelector("a");
            const imgContainer = card?.querySelector("div");
            if (!card || !imgContainer) return;

            card.classList.toggle("flex", view === "list");
            card.classList.toggle("flex-col", view === "list");
            card.classList.toggle("sm:flex-row", view === "list");
            card.classList.toggle("gap-6", view === "list");
            card.classList.toggle("items-start", view === "list");
            imgContainer.classList.toggle("aspect-square", view === "grid");
            imgContainer.classList.toggle("sm:w-64", view === "list");
            imgContainer.classList.toggle("shrink-0", view === "list");
            imgContainer.classList.toggle("aspect-video", view === "list");
            imgContainer.classList.toggle("sm:aspect-square", view === "list");
        });
    }

    categoryBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
            const url = new URL(window.location.href);
            const category = btn.dataset.category;
            if (!category || category === "all") {
                url.searchParams.delete("category");
            } else {
                url.searchParams.set("category", category);
            }
            window.history.pushState({}, "", url);
            updateFilters();
        });
    });

    priceRange?.addEventListener("input", (event) => {
        currentMaxPrice = Number(event.target.value);
        if (priceDisplay) {
            priceDisplay.textContent = `Rs.${currentMaxPrice.toLocaleString()}${currentMaxPrice === 10000 ? "+" : ""}`;
        }
        updateFilters();
    });

    sortSelect?.addEventListener("change", (event) => {
        const value = event.target.value;
        const sortedItems = [...productItems].sort((a, b) => {
            const priceA = Number(a.dataset.price || 0);
            const priceB = Number(b.dataset.price || 0);

            if (value === "price-low") return priceA - priceB;
            if (value === "price-high") return priceB - priceA;
            return (a.dataset.title || "").localeCompare(b.dataset.title || "");
        });

        sortedItems.forEach((item) => productGrid?.appendChild(item));
    });

    gridViewBtn?.addEventListener("click", () => setView("grid"));
    listViewBtn?.addEventListener("click", () => setView("list"));

    clearFiltersBtn?.addEventListener("click", () => {
        const url = new URL(window.location.href);
        url.searchParams.delete("category");
        url.searchParams.delete("q");
        window.history.pushState({}, "", url);
        currentMaxPrice = 10000;
        if (priceRange) priceRange.value = "10000";
        if (priceDisplay) priceDisplay.textContent = "Rs.10,000+";
        updateFilters();
    });

    updateFilters();
    setView("grid");
    window.addEventListener("popstate", updateFilters);
</script>
