---
import Layout from "../layouts/Layout.astro";
import { getProducts } from "../lib/catalog";

const products = await getProducts();
const productRoutes = products.map((product) => ({
    id: product.id,
    legacyId: product.data.legacyId,
    href: `/products/${product.id}`,
}));
---

<Layout title="Redirecting | Kanishka Creations">
    <main class="max-w-3xl mx-auto px-4 py-24 text-center">
        <h1 class="text-3xl font-bold mb-4">Redirecting to the product page</h1>
        <p class="text-slate-500 dark:text-slate-400">
            If the redirect does not happen automatically, continue browsing the
            collection.
        </p>
        <a href="/search" class="inline-flex mt-6 text-primary font-bold hover:underline">
            View all products
        </a>
    </main>
</Layout>

<script define:vars={{ productRoutes }}>
    const params = new URLSearchParams(window.location.search);
    const id = params.get("id");
    const match = productRoutes.find(
        (product) => product.id === id || product.legacyId === id,
    );

    window.location.replace(match?.href || "/search");
</script>
