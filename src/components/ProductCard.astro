---
interface Props {
    href: string;
    category: string;
    title: string;
    price: string;
    image: string;
    badge?: string | null;
    description?: string | null;
}

const { href, category, title, price, image, badge, description = "" } = Astro.props;
---

<div
    class="group relative h-full rounded-2xl border border-slate-200 bg-white p-4 shadow-[0_12px_24px_rgba(15,23,42,0.08)] transition-all duration-300 hover:-translate-y-0.5 hover:ring-2 hover:ring-primary/40"
>
    <a href={href} class="card-link block h-full">
        <div
            class="product-media relative aspect-square overflow-hidden rounded-xl bg-slate-100"
        >
            {
                badge && (
                    <div
                        class={`absolute top-2 left-2 z-10 ${badge === "HOT SELLING" ? "bg-primary text-background-dark" : "bg-slate-800 text-white"} font-bold text-[10px] px-2 py-1 rounded`}
                    >
                        {badge}
                    </div>
                )
            }
            <img
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
                src={image}
                alt={title}
            />
        </div>
        <div class="product-content mt-4 flex min-w-0 flex-col">
            <p
                class="inline-flex w-fit rounded-full border border-primary/20 bg-primary/10 px-2.5 py-1 text-[10px] font-bold uppercase tracking-[0.24em] text-primary"
            >
                {category}
            </p>
            <h3
                class="mt-2 text-[15px] font-bold leading-snug text-slate-900 transition-colors group-hover:text-primary line-clamp-2"
            >
                {title}
            </h3>
            <p class="product-description mt-2 hidden text-sm leading-6 text-slate-600 line-clamp-3">
                {description}
            </p>
            <div class="product-footer mt-3 flex items-center justify-between gap-4">
                <p class="product-price text-lg font-black text-slate-900">{price}</p>
                <span class="product-cta hidden items-center gap-1 text-xs font-bold uppercase tracking-[0.24em] text-primary">
                    View details
                    <span class="material-symbols-outlined text-sm">arrow_forward</span>
                </span>
            </div>
        </div>
    </a>
</div>
