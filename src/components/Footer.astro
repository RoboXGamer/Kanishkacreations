---
import { getCategories } from "../lib/catalog";
import type { CategoryEntry } from "../lib/catalog";

const shopLinks: CategoryEntry[] = await getCategories();
const salesEmail = import.meta.env.PUBLIC_SALES_EMAIL || "sales@kc-creations.in";
---

<footer
    class="bg-slate-50 pt-20 pb-10 border-t border-slate-200"
>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-12 mb-16">
            <div class="md:col-span-5">
                <a href="/" class="flex items-center gap-2 mb-6">
                    <span
                        class="material-symbols-outlined text-primary text-3xl"
                        >diamond</span
                    >
                    <h2
                        class="text-xl font-bold tracking-tight text-slate-900 uppercase"
                    >
                        Kanishka <span class="text-primary">Creations</span>
                    </h2>
                </a>
                <p
                    class="text-slate-600 text-sm leading-relaxed mb-6"
                >
                    Bringing premium craftsmanship and elegant designs to your
                    doorstep. Specializing in handmade accessories and luxury
                    corporate gifts.
                </p>
            </div>
            <div class="md:col-span-3">
                <h3 class="font-bold mb-6 text-slate-900">
                    Shop Links
                </h3>
                <ul
                    class="space-y-4 text-slate-600 text-sm"
                >
                    {
                        shopLinks.map((link) => (
                            <li>
                                <a
                                    class="hover:text-primary transition-colors"
                                    href={`/search?category=${link.id}`}
                                >
                                    {link.data.title}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>
            <div class="md:col-span-4">
                <h3 class="font-bold mb-6 text-slate-900">
                    Email us for any query
                </h3>
                <p class="text-slate-600 text-sm mb-4">
                    Reach out to us at <a
                        href={`mailto:${salesEmail}`}
                        class="text-primary hover:underline"
                        >{salesEmail}</a
                    >
                </p>
                <div class="flex flex-col gap-2">
                    <a
                        href={`mailto:${salesEmail}`}
                        class="bg-primary text-background-dark font-bold py-2.5 rounded-lg text-sm hover:bg-primary/90 transition-all text-center"
                        >Email us</a
                    >
                </div>
            </div>
        </div>
        <div
            class="pt-10 border-t border-slate-200 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-slate-500 font-medium"
        >
            <p>&copy; 2026 Kanishka Creations. All rights reserved.</p>
            <div class="flex gap-6 uppercase tracking-widest">
                <a class="hover:text-slate-900" href="/coming-soon">Terms</a>
                <a class="hover:text-slate-900" href="/coming-soon">Sitemap</a>
            </div>
        </div>
    </div>
</footer>
