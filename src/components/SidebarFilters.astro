---
import { getCategories } from "../lib/catalog";
import type { CategoryEntry } from "../lib/catalog";

const categories: CategoryEntry[] = await getCategories();
---

<aside class="w-full lg:w-72 shrink-0 space-y-10">
    <section>
        <h3
            class="text-xs font-bold uppercase tracking-widest text-slate-500 mb-6"
        >
            Collections
        </h3>
        <div class="flex flex-col gap-2">
            <button
                class="category-btn group flex items-center justify-between px-4 py-3 rounded-xl transition-all hover:bg-slate-100 active"
                data-category="all"
            >
                <div class="flex items-center gap-3">
                    <span
                        class="material-symbols-outlined text-slate-400 group-[.active]:text-primary transition-colors"
                        >grid_view</span
                    >
                    <span class="text-sm font-medium">All Collections</span>
                </div>
                <span
                    class="material-symbols-outlined text-sm opacity-0 group-[.active]:opacity-100 text-primary"
                    >check</span
                >
            </button>
            {
                categories.map((cat: any) => (
                    <button
                        class="category-btn group flex items-center justify-between px-4 py-3 rounded-xl transition-all hover:bg-slate-100"
                        data-category={cat.id}
                    >
                        <div class="flex items-center gap-3">
                            <span class="material-symbols-outlined text-slate-400 group-[.active]:text-primary transition-colors">
                                {cat.data.icon}
                            </span>
                            <span class="text-sm font-medium">
                                {cat.data.title}
                            </span>
                        </div>
                        <span class="material-symbols-outlined text-sm opacity-0 group-[.active]:opacity-100 text-primary">
                            check
                        </span>
                    </button>
                ))
            }
        </div>
    </section>

    <section>
        <div class="flex items-center justify-between mb-6">
            <h3
                class="text-xs font-bold uppercase tracking-widest text-slate-500"
            >
                Price Range
            </h3>
            <span
                id="price-display"
                class="text-xs font-bold text-primary px-2 py-1 bg-primary/10 rounded"
                >Rs.10,000+</span
            >
        </div>
        <div class="px-2">
            <input
                id="price-range"
                type="range"
                min="0"
                max="10000"
                step="100"
                value="10000"
                class="price-range w-full h-1.5 rounded-lg appearance-none cursor-pointer bg-slate-200"
            />
            <div
                class="flex justify-between mt-3 text-[10px] font-bold text-slate-400 uppercase tracking-tighter"
            >
                <span>Rs.0</span>
                <span>Rs.10,000+</span>
            </div>
        </div>
    </section>
</aside>

<style>
    .price-range {
        -webkit-appearance: none;
        appearance: none;
    }

    .price-range::-webkit-slider-runnable-track {
        height: 0.375rem;
        border-radius: 9999px;
        background: transparent;
    }

    .price-range::-webkit-slider-thumb {
        -webkit-appearance: none;
        appearance: none;
        width: 1.1rem;
        height: 1.1rem;
        margin-top: -0.375rem;
        border-radius: 9999px;
        background: #ffffff;
        border: 2px solid var(--color-primary);
        box-shadow: 0 0 0 4px rgba(15, 23, 42, 0.06);
    }

    .price-range::-moz-range-track {
        height: 0.375rem;
        border-radius: 9999px;
        background: transparent;
    }

    .price-range::-moz-range-thumb {
        width: 1.1rem;
        height: 1.1rem;
        border-radius: 9999px;
        background: #ffffff;
        border: 2px solid var(--color-primary);
        box-shadow: 0 0 0 4px rgba(15, 23, 42, 0.06);
    }

    .price-range:focus {
        outline: none;
    }

    .category-btn.active {
        background-color: color-mix(
            in srgb,
            var(--color-primary) 10%,
            transparent
        );
        color: var(--color-primary);
    }
</style>
