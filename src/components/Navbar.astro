---
import { getCategories } from "../lib/catalog";
import type { CategoryEntry } from "../lib/catalog";

const navItems: CategoryEntry[] = await getCategories();
---

<header
    class="sticky top-0 z-50 w-full border-b border-slate-200 bg-white/90 backdrop-blur-md"
>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
            <a href="/" class="flex items-center gap-2">
                <span class="material-symbols-outlined text-primary text-3xl"
                    >diamond</span
                >
                <h1
                    class="text-xl font-bold tracking-tight text-slate-900 uppercase"
                >
                    Kanishka <span class="text-primary">Creations</span>
                </h1>
            </a>
            <nav class="hidden md:flex items-center gap-8">
                {
                    navItems.map((item) => (
                        <a
                            class="group relative text-sm font-medium pb-1 transition-colors hover:text-primary after:absolute after:left-0 after:bottom-0 after:h-0.5 after:w-0 after:bg-primary after:transition-all after:duration-300 hover:after:w-full"
                            href={`/search?category=${item.id}`}
                        >
                            {item.data.title}
                        </a>
                    ))
                }
            </nav>
            <div class="flex items-center gap-4">
                <div class="relative hidden sm:block">
                    <span
                        class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-lg"
                        >search</span
                    >
                    <input
                        id="global-search"
                        class="border border-slate-300 rounded-full pl-10 pr-4 py-1.5 text-sm focus:ring-1 focus:ring-primary w-48 transition-all focus:w-64 bg-white text-slate-900 placeholder:text-slate-400"
                        placeholder="Search..."
                        type="text"
                    />
                </div>
                <a
                    href="/cart"
                    class="relative inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full hover:bg-slate-100 transition-colors"
                >
                    <span class="material-symbols-outlined text-lg leading-none">shopping_bag</span>
                    <span
                        id="cart-count"
                        class="absolute -top-0.5 -right-0.5 grid h-4 w-4 place-items-center rounded-full border border-slate-950 bg-primary text-[10px] font-bold leading-none text-background-dark"
                        >0</span
                    >
                </a>
            </div>
        </div>
    </div>
</header>

<script>
    import { getCartCount, readCart } from "../lib/checkout/cart";

    const searchInput = document.getElementById(
        "global-search",
    ) as HTMLInputElement;
    if (searchInput) {
        const currentQuery = new URLSearchParams(window.location.search).get("q");
        if (currentQuery) {
            searchInput.value = currentQuery;
        }

        searchInput.addEventListener("keypress", (e) => {
            if (e.key === "Enter") {
                const query = searchInput.value.trim();
                const currentUrl = new URL(window.location.href);
                const nextUrl = new URL("/search", window.location.origin);

                if (currentUrl.pathname === "/search") {
                    const currentCategory = currentUrl.searchParams.get("category");
                    if (currentCategory) {
                        nextUrl.searchParams.set("category", currentCategory);
                    }
                }

                if (query) {
                    nextUrl.searchParams.set("q", query);
                }

                window.location.href = nextUrl.toString();
            }
        });
    }

    const cartCount = document.getElementById("cart-count");
    const cart = readCart();
    if (cartCount) {
        cartCount.textContent = String(getCartCount(cart.items));
    }
</script>
