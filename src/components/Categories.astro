---
import { getCategories } from "../lib/catalog";
import type { CategoryEntry } from "../lib/catalog";

const categories: CategoryEntry[] = await getCategories();
---

<section class="py-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto" id="categories">
    <div
        class="flex flex-col md:flex-row justify-between items-end mb-12 gap-4"
    >
        <div>
            <h2 class="text-3xl font-bold text-slate-900">
                Shop by <span class="text-primary">Category</span>
            </h2>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {
            categories.map((cat: CategoryEntry) => (
                <div class="group relative h-112.5 flex flex-col justify-end overflow-hidden rounded-xl border border-slate-200 bg-white p-8 text-white transition-all hover:shadow-2xl hover:shadow-primary/5">
                    <div
                        class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-110"
                        style={`background-image: linear-gradient(to top, rgba(17, 17, 17, 0.82) 0%, rgba(17, 17, 17, 0.52) 46%, rgba(17, 17, 17, 0.12) 100%), url('${cat.data.image}');`}
                    />
                    <div class="relative z-10 text-left">
                        <h3 class="text-2xl font-bold mb-4">
                            {cat.data.title}
                        </h3>
                        <ul class="space-y-2 mb-6">
                            {cat.data.summaryItems.map((item: string) => (
                                <li class="text-white/85 text-sm flex items-center gap-2">
                                    <span class="h-1 w-1 bg-primary rounded-full" />
                                    {item}
                                </li>
                            ))}
                        </ul>
                        <a
                            href={`/search?category=${cat.id}`}
                            class="block w-full py-3 bg-slate-900 text-white hover:bg-primary hover:text-background-dark font-bold rounded-lg transition-all text-sm uppercase tracking-wider text-center"
                        >
                            {cat.data.buttonLabel}
                        </a>
                    </div>
                </div>
            ))
        }
    </div>
</section>
