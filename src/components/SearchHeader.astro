---
interface Props {
    title: string;
    itemsCount: number;
    category: string;
}

const { title, itemsCount, category } = Astro.props;
---

<div
    class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4"
>
    <div>
        <h2 class="text-2xl font-bold text-slate-900" id="search-title">
            {title}
        </h2>
        <p class="text-sm text-slate-500 mt-1">
            Showing <span id="items-count-display"
                >{itemsCount.toLocaleString()}</span
            > items in <span
                class="text-slate-900 font-medium"
                id="category-display"
            >
                {category}
            </span>
        </p>
    </div>
    <div class="flex items-center gap-4 w-full md:w-auto">
        <div
            class="flex items-center border border-slate-200 rounded-lg overflow-hidden h-10"
        >
            <button
                class="flex h-full items-center justify-center px-3 bg-slate-200 text-slate-900 border-r border-slate-200 grid-view-btn"
            >
                <span class="material-symbols-outlined text-xl">grid_view</span>
            </button>
            <button
                class="flex h-full items-center justify-center px-3 hover:bg-slate-100 text-slate-500 transition-colors list-view-btn"
            >
                <span class="material-symbols-outlined text-xl">view_list</span>
            </button>
        </div>
        <select
            id="sort-select"
            class="flex-1 md:flex-none bg-white border border-slate-200 rounded-lg py-2 pl-3 pr-10 text-sm focus:ring-primary focus:border-primary text-slate-900 outline-none cursor-pointer"
        >
            <option class="bg-white text-slate-900" value="popularity">Sort by: Popularity</option>
            <option class="bg-white text-slate-900" value="newest">Newest Arrivals</option>
            <option class="bg-white text-slate-900" value="price-low">Price: Low to High</option>
            <option class="bg-white text-slate-900" value="price-high">Price: High to Low</option>
        </select>
    </div>
</div>
