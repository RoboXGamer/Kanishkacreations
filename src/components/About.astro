---
import brandMission from "../assets/products/hair_accessories_brand_mission.jpeg";
---

<section class="py-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto" id="about">
	<div class="grid gap-8 lg:grid-cols-2 items-center rounded-3xl border border-white/10 bg-white/5 p-6 sm:p-8 lg:p-10 shadow-2xl shadow-black/20 backdrop-blur-md overflow-hidden">
		<div class="relative aspect-square overflow-hidden rounded-2xl bg-background-light ring-1 ring-white/10">
			<img
				src={brandMission.src}
				alt="Kanishka Creations brand and product styling"
				class="h-full w-full object-cover transition-transform duration-700 hover:scale-105"
			/>
			<div class="absolute left-4 top-4 rounded-full border border-primary/30 bg-background-dark/70 px-4 py-2 text-[11px] font-bold uppercase tracking-[0.3em] text-primary backdrop-blur-md">
				About Us
			</div>
		</div>

		<div class="lg:pl-4">
			<p class="mb-4 text-xs font-bold uppercase tracking-[0.35em] text-primary">
				Who We Are
			</p>
			<h2 class="text-3xl md:text-4xl font-bold text-white leading-tight mb-6 max-w-xl">
				A curated partner for premium retail, gifting, and custom product needs.
			</h2>
			<p class="text-slate-300 text-lg leading-relaxed max-w-2xl">
				Kanishka Creations combines polished design with dependable execution, bringing together elegant hair accessories, quality raw materials, and corporate gifting solutions that feel elevated from the first glance to the final delivery. We focus on product presentation, consistency across batches, and a smooth sourcing experience for businesses that want every detail to look intentional.
			</p>
		</div>
	</div>
</section>